#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PreparePC {
    uint localSizeX;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout(std430, binding = 0) readonly buffer CounterBuffer {
    uint counter;
};

layout(std430, binding = 1) writeonly buffer DispatchArgsBuffer {
    uint dispatchX;
    uint dispatchY;
    uint dispatchZ;
};

layout(std430, binding = 2) writeonly buffer CounterClearBuffer {
    uint counterClear;
};

void main()
{
    uint count = counter;
    uint groups = (count + pc.localSizeX - 1u) / max(pc.localSizeX, 1u);
    dispatchX = groups;
    dispatchY = 1u;
    dispatchZ = 1u;
    counterClear = 0u;
}
