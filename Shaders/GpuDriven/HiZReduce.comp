#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uvec2 dstExtent;
    uint  reverseZ;
    uint  _pad;
} pc;

layout(binding = 0, r32f) readonly  uniform image2D srcMip;
layout(binding = 1, r32f) writeonly uniform image2D dstMip;

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.dstExtent.x || gid.y >= pc.dstExtent.y)
        return;

    ivec2 srcBase = ivec2(gid) * 2;
    ivec2 srcSize = imageSize(srcMip);

    float d0 = imageLoad(srcMip, min(srcBase + ivec2(0, 0), srcSize - 1)).r;
    float d1 = imageLoad(srcMip, min(srcBase + ivec2(1, 0), srcSize - 1)).r;
    float d2 = imageLoad(srcMip, min(srcBase + ivec2(0, 1), srcSize - 1)).r;
    float d3 = imageLoad(srcMip, min(srcBase + ivec2(1, 1), srcSize - 1)).r;

    // Farthest depth in the 2x2: max for normal-Z, min for reverse-Z.
    float farthest = (pc.reverseZ != 0u)
                         ? min(min(d0, d1), min(d2, d3))
                         : max(max(d0, d1), max(d2, d3));

    imageStore(dstMip, ivec2(gid), vec4(farthest, 0.0, 0.0, 0.0));
}
