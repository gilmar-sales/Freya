#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct MeshInfo {
    uint lodCount;
    uint lodBase;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    uint _pad3;
    uint _pad4;
    uint _pad5;
    vec4 aabbMin;
    vec4 aabbMax;
};

struct MeshLodInfo {
    uint indexCount;
    uint firstIndex;
    int  vertexOffset;
    uint _pad;
};

struct SceneInstance {
    mat4 model;
    uint meshId;
    uint materialId;
    uint entityId;
    uint flags;
    uint techniqueId;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct InstanceTransform {
    mat4 model;
    mat4 prevModel;
    uint materialId;
    uint entityId;
    uint flags;
    uint boneOffset;
};

layout(push_constant) uniform CullPC {
    mat4 viewProj;
    vec4 cameraPos;
    vec2 screenSize;
    uint instanceCount;
    uint cullMode;
    uint reverseZ;
    uint hizEnabled;
    float lodPixelRef;
    float lodStep;
    uint techniqueFilter;
    uint _padTech;
    uint maxDraws;
    float hizDepthBias; // NDC-space bias; tune to your near/far + Hi-Z precision
} cull;

layout(std430, binding = 0) readonly buffer MeshInfoBuffer {
    MeshInfo meshes[];
};

layout(std430, binding = 1) readonly buffer SceneInstanceBuffer {
    SceneInstance instances[];
};

layout(std430, binding = 2) writeonly buffer IndirectBuffer {
    DrawIndexedIndirectCommand draws[];
};

layout(std430, binding = 3) readonly buffer SourceTransforms {
    InstanceTransform sources[];
};

layout(std430, binding = 4) writeonly buffer CompactTransforms {
    InstanceTransform compact[];
};

layout(std430, binding = 5) readonly buffer MeshLodBuffer {
    MeshLodInfo lods[];
};

layout(std430, binding = 6) buffer DrawCountBuffer {
    uint drawCount;
};

layout(binding = 7) uniform sampler2D hizPyramid;

const uint kFlagCastShadows   = 1u;
const uint kFlagTranslucent   = 2u;
const uint kFlagSkinned       = 4u;
const uint kCullModeCamera      = 0u;
const uint kCullModeShadow      = 1u;
const uint kCullModeTranslucent = 2u;

// Corner index pairs that form the 12 edges of an AABB (used only for
// near-plane clipping when projecting to screen space).
const int kAabbEdges[24] = int[](
    0, 1, 0, 2, 0, 4, 1, 3, 1, 5, 2, 3,
    2, 6, 3, 7, 4, 5, 4, 6, 5, 7, 6, 7);

// Transforms the 8 AABB corners into clip space exactly once. Every other
// function below (frustum test, screen-space projection, Hi-Z sampling)
// reuses this array instead of re-multiplying by `mvp`.
void computeClipCorners(mat4 mvp, vec3 bmin, vec3 bmax, out vec4 corners[8])
{
    vec3 local[8] = vec3[](
        vec3(bmin.x, bmin.y, bmin.z),
        vec3(bmax.x, bmin.y, bmin.z),
        vec3(bmin.x, bmax.y, bmin.z),
        vec3(bmax.x, bmax.y, bmin.z),
        vec3(bmin.x, bmin.y, bmax.z),
        vec3(bmax.x, bmin.y, bmax.z),
        vec3(bmin.x, bmax.y, bmax.z),
        vec3(bmax.x, bmax.y, bmax.z));

    for (int i = 0; i < 8; ++i)
        corners[i] = mvp * vec4(local[i], 1.0);
}

// Clips the AABB's 12 edges against the eye plane (w=0) and appends the
// result to `clipped`, returning the point count. Corners already in
// front of the camera (w>0) are kept as-is; edges whose endpoints straddle
// w=0 contribute one interpolated point at the crossing. This mirrors the
// near-plane clipping `projectAabb` already does for screen-space
// projection: dividing by a negative w flips the sign of the x/y-vs-w
// comparisons below, so mixing w>0 and w<=0 corners in the same
// left/right/top/bottom test is unsound for AABBs large enough (post
// scale/inflation) to straddle the camera's eye plane.
int clipCornersAtEyePlane(vec4 corners[8], out vec4 clipped[14])
{
    int count = 0;
    for (int i = 0; i < 8; ++i)
    {
        if (corners[i].w > 0.0)
            clipped[count++] = corners[i];
    }
    for (int edge = 0; edge < 12; ++edge)
    {
        vec4 ca = corners[kAabbEdges[edge * 2]];
        vec4 cb = corners[kAabbEdges[edge * 2 + 1]];
        if ((ca.w > 0.0) == (cb.w > 0.0))
            continue;
        float t = ca.w / (ca.w - cb.w);
        clipped[count++] = mix(ca, cb, t);
    }
    return count;
}

// True only if ALL corners fall outside the same frustum plane
// (a conservative, correct "fully outside" test). The left/right/top/
// bottom tests run on the eye-plane-clipped point set (see
// clipCornersAtEyePlane) so corners behind the camera never corrupt the
// result; near/far still use the raw corners since they are what actually
// decide "behind the eye" / "past the far plane" and are already sign-
// correct per reverseZ. If no corner survives eye-plane clipping the AABB
// is fully behind the camera, and the untouched (still-true) left/right/
// top/bottom flags correctly report "outside" below.
bool aabbOutsideFrustum(vec4 corners[8])
{
    vec4 clipped[14];
    int  clippedCount = clipCornersAtEyePlane(corners, clipped);

    bool outsideLeft   = true;
    bool outsideRight  = true;
    bool outsideBottom = true;
    bool outsideTop    = true;
    bool outsideNear   = true;
    bool outsideFar    = true;

    for (int i = 0; i < clippedCount; ++i)
    {
        vec4 c = clipped[i];
        outsideLeft   = outsideLeft   && (c.x < -c.w);
        outsideRight  = outsideRight  && (c.x >  c.w);
        outsideBottom = outsideBottom && (c.y < -c.w);
        outsideTop    = outsideTop    && (c.y >  c.w);
    }

    for (int i = 0; i < 8; ++i)
    {
        vec4 c = corners[i];
        if (cull.reverseZ != 0u)
        {
            outsideNear = outsideNear && (c.z > c.w);
            outsideFar  = outsideFar  && (c.z < 0.0);
        }
        else
        {
            outsideNear = outsideNear && (c.z < 0.0);
            outsideFar  = outsideFar  && (c.z > c.w);
        }
    }

    return outsideLeft || outsideRight || outsideBottom || outsideTop ||
           outsideNear || outsideFar;
}

void includeProjectedPoint(vec4 clip, inout vec2 smin, inout vec2 smax,
                            inout float nearestZ, inout int valid)
{
    if (clip.w <= 0.0)
        return;

    float z = clamp(clip.z / clip.w, 0.0, 1.0);

    vec2 uv = (clip.xy / clip.w) * 0.5 + 0.5;
    smin = min(smin, uv);
    smax = max(smax, uv);
    if (cull.reverseZ != 0u)
        nearestZ = max(nearestZ, z);
    else
        nearestZ = min(nearestZ, z);
    ++valid;
}

// Projects the AABB to a screen-space rectangle + nearest depth, clipping
// against the near plane so corners behind the camera don't distort the
// result. Takes the already-transformed clip-space corners; no re-transform.
bool projectAabb(vec4 corners[8], out vec2 smin, out vec2 smax,
                  out float nearestZ)
{
    smin = vec2(1e10);
    smax = vec2(-1e10);
    nearestZ = cull.reverseZ != 0u ? -1e10 : 1e10;
    int valid = 0;

    for (int i = 0; i < 8; ++i)
        includeProjectedPoint(corners[i], smin, smax, nearestZ, valid);

    for (int edge = 0; edge < 12; ++edge)
    {
        vec4 ca = corners[kAabbEdges[edge * 2]];
        vec4 cb = corners[kAabbEdges[edge * 2 + 1]];
        float pa = cull.reverseZ != 0u ? ca.w - ca.z : ca.z;
        float pb = cull.reverseZ != 0u ? cb.w - cb.z : cb.z;
        if ((pa < 0.0) == (pb < 0.0) || pa == pb)
            continue;
        float t = pa / (pa - pb);
        includeProjectedPoint(mix(ca, cb, t), smin, smax, nearestZ, valid);
    }

    return valid != 0;
}

uint selectLod(float screenDiameter, uint lodCount)
{
    if (lodCount <= 1u || cull.cullMode == kCullModeShadow)
        return 0u;

    float ref = max(cull.lodPixelRef, 1.0);
    float step = max(cull.lodStep, 1.01);
    uint lod = 0u;
    float threshold = ref;
    while (lod + 1u < lodCount && screenDiameter < threshold)
    {
        ++lod;
        threshold /= step;
    }
    return lod;
}

// Takes an already-computed screen-space rect + nearest depth (from
// projectAabb) instead of re-projecting the AABB a second time.
bool occludedByHiZ(vec2 smin, vec2 smax, float nearestZ)
{
    if (cull.hizEnabled == 0u)
        return false;

    vec2 csmin = clamp(smin, vec2(0.0), vec2(1.0));
    vec2 csmax = clamp(smax, vec2(0.0), vec2(1.0));
    // No on-screen footprint: corner projection missed the viewport
    // (common for large near geometry). Pixel/mip padding would invent a
    // thin edge sample and false-occlude — treat as visible instead.
    if (any(lessThanEqual(csmax, csmin)))
        return false;

    // Hi-Z may be half-res (or fixture dump sized); never use framebuffer
    // screenSize for mip selection / texel padding.
    vec2 hizSize = max(vec2(textureSize(hizPyramid, 0)), vec2(1.0));
    vec2 pixelSize = 1.0 / hizSize;
    csmin = max(vec2(0.0), csmin - pixelSize * 0.5);
    csmax = min(vec2(1.0), csmax + pixelSize * 0.5);

    vec2 sizePx = (csmax - csmin) * hizSize;
    float maxDim = max(max(sizePx.x, sizePx.y), 1.0);

    // ceil (not floor): guarantees the sampled texel's footprint is at
    // least as large as the screen-space rectangle. floor() can pick a
    // texel smaller than the rectangle, so which texel a corner lands in
    // becomes sensitive to sub-pixel movement -> flicker frame to frame.
    float mip = ceil(log2(maxDim));
    float levels = float(textureQueryLevels(hizPyramid));
    mip = clamp(mip, 0.0, max(levels - 1.0, 0.0));
    vec2 mipExtent = max(ceil(hizSize / exp2(mip)), vec2(1.0));
    vec2 mipTexel = 1.0 / mipExtent;
    csmin = max(vec2(0.0), csmin - mipTexel * 0.5);
    csmax = min(vec2(1.0), csmax + mipTexel * 0.5);

    vec2 samples[5] = vec2[](
        csmin,
        vec2(csmax.x, csmin.y),
        vec2(csmin.x, csmax.y),
        csmax,
        (csmin + csmax) * 0.5);

    float occluder = cull.reverseZ != 0u ? 1e10 : -1e10;
    for (int i = 0; i < 5; ++i)
    {
        float sampleZ = textureLod(hizPyramid, samples[i], mip).r;
        if (cull.reverseZ != 0u)
            occluder = min(occluder, sampleZ);
        else
            occluder = max(occluder, sampleZ);
    }

    // Small bias so results near the occlusion boundary don't flip sign
    // from float noise between frames (AABB vs. real rendered depth).
    float bias = cull.hizDepthBias;
    if (cull.reverseZ != 0u)
        return (occluder - nearestZ) > bias;
    return (nearestZ - occluder) > bias;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= cull.instanceCount)
        return;

    SceneInstance inst = instances[id];

    if (cull.techniqueFilter != 0xFFFFFFFFu &&
        inst.techniqueId != cull.techniqueFilter)
        return;

    if (cull.cullMode == kCullModeShadow &&
        (inst.flags & kFlagCastShadows) == 0u)
        return;
    if (cull.cullMode == kCullModeTranslucent &&
        (inst.flags & kFlagTranslucent) == 0u)
        return;
    if (cull.cullMode == kCullModeCamera &&
        (inst.flags & kFlagTranslucent) != 0u)
        return;

    MeshInfo mesh = meshes[inst.meshId];
    if (mesh.lodCount == 0u)
        return;

    mat4 mvp = cull.viewProj * inst.model;

    // Transform the 8 corners ONCE. Everything below reuses this array
    // instead of re-multiplying by mvp (the previous version did this
    // transform up to 4x per instance: once for the frustum test, once
    // in the vertex loop of projectAabb, once more for its edge loop,
    // and once again inside a second, redundant projectAabb call from
    // occludedByHiZ).
    vec4 clipCorners[8];
    computeClipCorners(mvp, mesh.aabbMin.xyz, mesh.aabbMax.xyz, clipCorners);

    if (aabbOutsideFrustum(clipCorners))
        return;

    vec2 projMin, projMax;
    float projNearestZ;
    if (!projectAabb(clipCorners, projMin, projMax, projNearestZ))
        return;

    // Skinned AABBs are rest-pose inflated approximations; Hi-Z would false-
    // cull posed silhouette. Match translucent: frustum-only.
    if (cull.cullMode != kCullModeShadow &&
        cull.cullMode != kCullModeTranslucent &&
        (inst.flags & kFlagSkinned) == 0u &&
        occludedByHiZ(projMin, projMax, projNearestZ))
        return;

    // Clamp to the viewport before measuring screen size, so an AABB that
    // extends past the screen edges doesn't inflate the LOD selection.
    vec2 clampedMin = clamp(projMin, vec2(0.0), vec2(1.0));
    vec2 clampedMax = clamp(projMax, vec2(0.0), vec2(1.0));
    float screenDiameter = length((clampedMax - clampedMin) * cull.screenSize);

    uint lod = selectLod(screenDiameter, mesh.lodCount);
    MeshLodInfo range = lods[mesh.lodBase + lod];
    if (range.indexCount == 0u)
        return;

    uint slot = atomicAdd(drawCount, 1u);
    if (slot >= cull.maxDraws)
        return;
    draws[slot].indexCount    = range.indexCount;
    draws[slot].instanceCount = 1u;
    draws[slot].firstIndex    = range.firstIndex;
    draws[slot].vertexOffset  = range.vertexOffset;
    draws[slot].firstInstance = slot;
    compact[slot] = sources[id];
}
