#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Approach A: CPU emits one indirect draw per contiguous mesh batch
// (instanceCount = 0). Each instance thread frustum-tests, then
// atomicAdd's into that batch's instanceCount and writes a compacted
// InstanceTransform so the VS sees a dense [firstInstance, +visible).

struct MeshInfo {
    uint indexCount;
    uint firstIndex;
    int  vertexOffset;
    uint vertexBufferIndex;
    uint indexBufferIndex;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    vec4 aabbMin;
    vec4 aabbMax;
};

struct SceneInstance {
    mat4 model;
    uint meshId;
    uint materialId;
    uint entityId;
    uint flags;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct InstanceTransform {
    mat4 model;
    mat4 prevModel;
    uint materialId;
    uint entityId;
    uint flags;
    uint _pad;
};

layout(push_constant) uniform CullPC {
    mat4 viewProj;
    uint instanceCount;
    uint cullMode;
    uint reverseZ;
    uint _pad0;
} cull;

layout(std430, binding = 0) readonly buffer MeshInfoBuffer {
    MeshInfo meshes[];
};

layout(std430, binding = 1) readonly buffer SceneInstanceBuffer {
    SceneInstance instances[];
};

layout(std430, binding = 2) buffer IndirectBuffer {
    DrawIndexedIndirectCommand draws[];
};

layout(std430, binding = 3) readonly buffer SourceTransforms {
    InstanceTransform sources[];
};

layout(std430, binding = 4) writeonly buffer CompactTransforms {
    InstanceTransform compact[];
};

layout(std430, binding = 5) readonly buffer BatchIdBuffer {
    uint batchIds[];
};

const uint kFlagCastShadows = 1u;
const uint kCullModeShadow  = 1u;

bool aabbOutsideFrustum(mat4 mvp, vec3 bmin, vec3 bmax)
{
    vec3 corners[8] = vec3[](
        vec3(bmin.x, bmin.y, bmin.z),
        vec3(bmax.x, bmin.y, bmin.z),
        vec3(bmin.x, bmax.y, bmin.z),
        vec3(bmax.x, bmax.y, bmin.z),
        vec3(bmin.x, bmin.y, bmax.z),
        vec3(bmax.x, bmin.y, bmax.z),
        vec3(bmin.x, bmax.y, bmax.z),
        vec3(bmax.x, bmax.y, bmax.z));

    int outLeft = 0, outRight = 0, outBottom = 0, outTop = 0;
    int outNear = 0, outFar = 0;

    for (int i = 0; i < 8; ++i)
    {
        vec4 clip = mvp * vec4(corners[i], 1.0);
        if (clip.w <= 0.0)
        {
            ++outNear;
            continue;
        }
        if (clip.x < -clip.w) ++outLeft;
        if (clip.x >  clip.w) ++outRight;
        if (clip.y < -clip.w) ++outBottom;
        if (clip.y >  clip.w) ++outTop;
        if (cull.reverseZ != 0u)
        {
            if (clip.z < 0.0)     ++outFar;
            if (clip.z >  clip.w) ++outNear;
        }
        else
        {
            if (clip.z < 0.0)     ++outNear;
            if (clip.z >  clip.w) ++outFar;
        }
    }

    return outLeft == 8 || outRight == 8 || outBottom == 8 || outTop == 8 ||
           outNear == 8 || outFar == 8;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= cull.instanceCount)
        return;

    SceneInstance inst = instances[id];

    if (cull.cullMode == kCullModeShadow &&
        (inst.flags & kFlagCastShadows) == 0u)
        return;

    MeshInfo mesh = meshes[inst.meshId];
    mat4 mvp = cull.viewProj * inst.model;
    if (aabbOutsideFrustum(mvp, mesh.aabbMin.xyz, mesh.aabbMax.xyz))
        return;

    uint batchId = batchIds[id];
    uint slot = atomicAdd(draws[batchId].instanceCount, 1u);
    uint dst = draws[batchId].firstInstance + slot;
    compact[dst] = sources[id];
}
