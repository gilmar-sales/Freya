#version 450

// Edge-aware separable bilateral; radius matches 4x4 SSAO noise tile.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D ssaoIn;
layout(binding = 1) uniform sampler2D normalBuffer;
layout(binding = 2) uniform sampler2D depthBuffer;
layout(binding = 3, r8) writeonly uniform image2D ssaoOut;

layout(push_constant) uniform PC {
    vec2  invResolution;
    vec2  direction;
    float depthSigma;  // 1 / (2 * sigma^2) in view units
    float normalSigma;
    float reverseZ;
    float _pad;
    mat4  invProjection;
} pc;

vec3 ViewPosFromDepth(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 view = pc.invProjection * clip;
    return view.xyz / view.w;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(ssaoOut);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) * pc.invResolution;
    float centerAO = textureLod(ssaoIn, uv, 0.0).r;
    float centerDepth = textureLod(depthBuffer, uv, 0.0).r;
    vec3 centerN = normalize(textureLod(normalBuffer, uv, 0.0).xyz * 2.0 - 1.0);

    bool sky = pc.reverseZ > 0.5 ? (centerDepth <= 1e-6)
                                 : (centerDepth >= 0.999999);
    if (sky) {
        imageStore(ssaoOut, pixel, vec4(1.0));
        return;
    }

    float centerViewZ = ViewPosFromDepth(uv, centerDepth).z;

    const float kWeights[5] =
        float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);

    float result = centerAO * kWeights[0];
    float weightSum = kWeights[0];

    for (int i = 1; i < 5; ++i) {
        vec2 offset = pc.direction * float(i) * pc.invResolution;
        for (int s = -1; s <= 1; s += 2) {
            vec2 sampleUV = uv + offset * float(s);
            float sampleAO = textureLod(ssaoIn, sampleUV, 0.0).r;
            float sampleDepth = textureLod(depthBuffer, sampleUV, 0.0).r;
            vec3 sampleN =
                normalize(textureLod(normalBuffer, sampleUV, 0.0).xyz * 2.0 - 1.0);

            float sampleViewZ = ViewPosFromDepth(sampleUV, sampleDepth).z;
            float depthDiff = abs(sampleViewZ - centerViewZ);
            float depthW = exp(-depthDiff * depthDiff * pc.depthSigma);
            float nDot = max(dot(centerN, sampleN), 0.0);
            float normalW = pow(nDot, pc.normalSigma);
            float w = kWeights[i] * depthW * normalW;
            result += sampleAO * w;
            weightSum += w;
        }
    }

    imageStore(ssaoOut, pixel, vec4(result / max(weightSum, 1e-4)));
}
