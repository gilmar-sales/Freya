#version 450

// Half-res SSAO in view space (radius/bias in view units).
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D depthBuffer;
layout(binding = 1) uniform sampler2D normalBuffer;
layout(binding = 2) uniform sampler2D noiseTex;
layout(binding = 3, r8) writeonly uniform image2D ssaoOut;

layout(binding = 4) uniform SsaoCamera {
    mat4 invProjection;
    mat4 view;
    mat4 projection;
    vec4 params; // x=radius y=bias z=power w=intensity
    vec4 res;    // xy=invResolution(ssao) z=reverseZ w=unused
} cam;

const int kKernelSize = 8;

const vec3 kKernel[8] = vec3[](
    vec3(0.0495, -0.0445, 0.0987), vec3(0.0921, 0.0512, 0.0744),
    vec3(-0.0675, 0.0234, 0.1101), vec3(0.0256, 0.1312, 0.0398),
    vec3(-0.1245, -0.0412, 0.0556), vec3(0.1456, 0.0334, 0.0412),
    vec3(0.0389, -0.1567, 0.0298), vec3(-0.1145, -0.1278, 0.0412));

vec3 ViewPosFromDepth(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 view = cam.invProjection * clip;
    return view.xyz / view.w;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(ssaoOut);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) * cam.res.xy;
    float depth = textureLod(depthBuffer, uv, 0.0).r;
    bool reverseZ = cam.res.z > 0.5;
    if (reverseZ ? (depth <= 1e-6) : (depth >= 0.999999)) {
        imageStore(ssaoOut, pixel, vec4(1.0));
        return;
    }

    vec3 viewPos = ViewPosFromDepth(uv, depth);
    vec3 worldN = normalize(textureLod(normalBuffer, uv, 0.0).xyz * 2.0 - 1.0);
    vec3 viewN = normalize(mat3(cam.view) * worldN);

    vec3 randVec =
        textureLod(noiseTex, vec2(pixel) / 4.0, 0.0).xyz * 2.0 - 1.0;
    randVec = normalize(vec3(randVec.xy, 0.0));
    vec3 tangent = normalize(randVec - viewN * dot(randVec, viewN));
    vec3 bitangent = cross(viewN, tangent);
    mat3 TBN = mat3(tangent, bitangent, viewN);

    float radius = cam.params.x;
    float bias = cam.params.y;
    float occlusion = 0.0;
    float weightSum = 0.0;

    for (int i = 0; i < kKernelSize; ++i) {
        vec3 sampleView = viewPos + TBN * (kKernel[i] * radius);
        vec4 clip = cam.projection * vec4(sampleView, 1.0);
        vec3 ndc = clip.xyz / max(clip.w, 1e-5);
        vec2 sampleUV = ndc.xy * 0.5 + 0.5;
        if (any(lessThan(sampleUV, vec2(0.0))) ||
            any(greaterThan(sampleUV, vec2(1.0))))
            continue;

        float sampleDepth = textureLod(depthBuffer, sampleUV, 0.0).r;
        vec3 occluderView = ViewPosFromDepth(sampleUV, sampleDepth);

        // View looks down -Z; closer => larger z (less negative).
        float rangeCheck =
            smoothstep(0.0, 1.0, radius / max(abs(viewPos.z - occluderView.z), 1e-3));
        float occlude = (occluderView.z >= sampleView.z + bias) ? 1.0 : 0.0;
        occlusion += occlude * rangeCheck;
        weightSum += 1.0;
    }

    float ao = 1.0;
    if (weightSum > 0.5)
        ao = 1.0 - (occlusion / weightSum);
    ao = pow(clamp(ao, 0.0, 1.0), cam.params.z);
    ao = mix(1.0, ao, clamp(cam.params.w, 0.0, 2.0));
    imageStore(ssaoOut, pixel, vec4(ao));
}
