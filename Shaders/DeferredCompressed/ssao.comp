#version 450

// Screen-space AO (Crytek / LearnOpenGL hemisphere sample).
// View-space radius/bias in meters. Noise-tiled, then bilateral blurred.
// Reference: Joey de Vries — LearnOpenGL SSAO
//   https://learnopengl.com/Advanced-Lighting/SSAO
// Plus plane-distance reject (Alchemy-style) to kill flat hard-surface acne
// common on dense CAD / vehicle meshes.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D depthBuffer;
layout(binding = 1) uniform sampler2D normalBuffer;
layout(binding = 2) uniform sampler2D noiseTex;
layout(binding = 3, r8) writeonly uniform image2D ssaoOut;

layout(binding = 4) uniform SsaoCamera {
    mat4 invProjection;
    mat4 view;
    mat4 projection;
    vec4 params; // x=radius y=bias z=power w=intensity
    vec4 res;    // xy=invResolution(ssao) z=reverseZ w=unused
} cam;

// 16 hemisphere samples, lengths lerp(0.1,1,t²) like LearnOpenGL (seed 42).
const int kKernelSize = 16;
const vec3 kKernel[16] = vec3[](
    vec3(0.027138, -0.092451, 0.026766),
    vec3(-0.057650, 0.049252, 0.070471),
    vec3(0.073647, -0.077569, 0.039616),
    vec3(-0.102580, -0.061382, 0.055125),
    vec3(-0.114090, -0.072571, 0.078301),
    vec3(0.020664, -0.128542, 0.135473),
    vec3(0.098983, -0.157865, 0.128886),
    vec3(0.202711, -0.163435, 0.079533),
    vec3(0.304655, -0.108882, 0.030900),
    vec3(-0.253556, 0.218480, 0.189790),
    vec3(0.296364, 0.221680, 0.258717),
    vec3(0.443044, -0.113745, 0.258476),
    vec3(0.359727, 0.129430, 0.470514),
    vec3(0.244166, 0.645742, 0.072324),
    vec3(-0.619831, -0.479761, 0.090881),
    vec3(-0.476253, -0.711145, 0.247720));

vec3 ViewPosFromDepth(vec2 uv, float depth) {
    // Vulkan + GLM_FORCE_DEPTH_ZERO_TO_ONE: NDC.z ∈ [0,1] matches depth.
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 view = cam.invProjection * clip;
    return view.xyz / view.w;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(ssaoOut);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) * cam.res.xy;
    float depth = textureLod(depthBuffer, uv, 0.0).r;
    bool reverseZ = cam.res.z > 0.5;
    if (reverseZ ? (depth <= 1e-6) : (depth >= 0.999999)) {
        imageStore(ssaoOut, pixel, vec4(1.0));
        return;
    }

    vec3 viewPos = ViewPosFromDepth(uv, depth);
    vec3 worldN = normalize(textureLod(normalBuffer, uv, 0.0).xyz * 2.0 - 1.0);
    vec3 viewN = normalize(mat3(cam.view) * worldN);

    // Tile 4×4 noise (REPEAT sampler). Same layout as LearnOpenGL noiseScale.
    vec3 randomVec =
        textureLod(noiseTex, vec2(pixel) / 4.0, 0.0).xyz * 2.0 - 1.0;
    randomVec.z = 0.0;
    if (dot(randomVec.xy, randomVec.xy) < 1e-6)
        randomVec = vec3(1.0, 0.0, 0.0);
    else
        randomVec = normalize(randomVec);

    // Gram-Schmidt TBN (tangent ⊥ normal).
    vec3 tangent = randomVec - viewN * dot(randomVec, viewN);
    if (dot(tangent, tangent) < 1e-6)
        tangent = cross(viewN, abs(viewN.y) < 0.999 ? vec3(0.0, 1.0, 0.0)
                                                     : vec3(1.0, 0.0, 0.0));
    tangent = normalize(tangent);
    vec3 bitangent = cross(viewN, tangent);
    mat3 TBN = mat3(tangent, bitangent, viewN);

    float radius = max(cam.params.x, 1e-4);
    float bias = max(cam.params.y, 1e-5);
    float radius2 = radius * radius;
    float occlusion = 0.0;

    for (int i = 0; i < kKernelSize; ++i) {
        // LearnOpenGL: samplePos = fragPos + (TBN * sample) * radius
        vec3 samplePos = viewPos + TBN * kKernel[i] * radius;

        vec4 clip = cam.projection * vec4(samplePos, 1.0);
        if (clip.w <= 1e-5)
            continue;

        vec3 ndc = clip.xyz / clip.w;
        vec2 sampleUV = ndc.xy * 0.5 + 0.5;
        if (any(lessThan(sampleUV, vec2(0.0))) ||
            any(greaterThan(sampleUV, vec2(1.0))))
            continue;

        float sampleDepth = textureLod(depthBuffer, sampleUV, 0.0).r;
        vec3 occluderPos = ViewPosFromDepth(sampleUV, sampleDepth);

        // Vector from shaded point to scene geometry under the sample.
        vec3 v = occluderPos - viewPos;
        float vv = dot(v, v);
        if (vv > radius2 || vv < 1e-8)
            continue;

        // Plane bias: ignore nearly-coplanar hits (dense hull / hard edges acne).
        // Real creases / contacts leave the tangent plane (vn >> bias).
        float vn = dot(v, viewN);
        if (vn <= bias)
            continue;

        // View looks down -Z; closer ⇒ larger z. Occluder closer than kernel
        // sample ⇒ blocks the sample (LearnOpenGL test).
        if (occluderPos.z < samplePos.z + bias)
            continue;

        // Soft 3D falloff (more stable than |Δz| alone on slanted hulls).
        float rangeCheck = 1.0 - smoothstep(radius2 * 0.25, radius2, vv);
        // Weight by how far the hit leaves the plane (reduces grazing false AO).
        float planeW = smoothstep(bias, bias * 4.0, vn);
        occlusion += rangeCheck * planeW;
    }

    float ao = 1.0 - (occlusion / float(kKernelSize));
    ao = pow(clamp(ao, 0.0, 1.0), max(cam.params.z, 1e-3));
    ao = mix(1.0, ao, clamp(cam.params.w, 0.0, 1.0));
    imageStore(ssaoOut, pixel, vec4(clamp(ao, 0.0, 1.0)));
}
