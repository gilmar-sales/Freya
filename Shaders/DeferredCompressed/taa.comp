#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D currentColor;
layout(binding = 1) uniform sampler2D velocityBuffer;
layout(binding = 2) uniform sampler2D historyColor;
layout(binding = 3, rgba16f) writeonly uniform image2D outputColor;
layout(binding = 4) uniform sampler2D currentDepth;
layout(binding = 5) uniform sampler2D historyDepth;
layout(binding = 6, r16f) writeonly uniform image2D outputDepth;

// quality: 0=Low, 1=Medium, 2=High, 3=Ultra
layout(push_constant) uniform PushConstants {
    vec2  invResolution;
    float currentWeight;
    float historyValid;
    float varianceGammaY;
    float varianceGammaC;
    float depthReject;
    float sharpen;
    float quality;
    float reverseZ; // 1 when Reverse-Z (larger depth = closer)
    float _pad0;
    float _pad1;
} pc;

const int Q_LOW    = 0;
const int Q_MEDIUM = 1;
const int Q_HIGH   = 2;
const int Q_ULTRA  = 3;

vec3 RGBToYCoCg(vec3 c) {
    float Y  = dot(c, vec3(0.25, 0.5, 0.25));
    float Co = dot(c, vec3(0.5, 0.0, -0.5));
    float Cg = dot(c, vec3(-0.25, 0.5, -0.25));
    return vec3(Y, Co, Cg);
}

vec3 YCoCgToRGB(vec3 c) {
    float t = c.x - c.z;
    return vec3(t + c.y, c.x + c.z, t - c.y);
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool IsCloser(float candidate, float reference) {
    return pc.reverseZ > 0.5 ? (candidate > reference)
                             : (candidate < reference);
}

// Closest-depth velocity in 3×3 — anchors silhouettes under motion.
vec2 DilateVelocity(ivec2 pixel, out float closestDepth) {
    closestDepth = texelFetch(currentDepth, pixel, 0).r;
    vec2 bestVel = texelFetch(velocityBuffer, pixel, 0).xy;

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0)
                continue;
            ivec2 p = pixel + ivec2(x, y);
            float d = texelFetch(currentDepth, p, 0).r;
            if (IsCloser(d, closestDepth)) {
                closestDepth = d;
                bestVel      = texelFetch(velocityBuffer, p, 0).xy;
            }
        }
    }
    return bestVel;
}

// Widen variance AABB on depth edges / motion so sub-pixel border AA is
// not clipped away (avoids exposing raw jitter = shimmer).
float GammaBoost(ivec2 pixel, vec2 velocity) {
    float dMin = 1e10;
    float dMax = -1e10;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            float d = texelFetch(currentDepth, pixel + ivec2(x, y), 0).r;
            dMin    = min(dMin, d);
            dMax    = max(dMax, d);
        }
    }
    float depthEdge = clamp((dMax - dMin) * 25.0, 0.0, 1.0);
    float speedPx =
        length(velocity / max(pc.invResolution, vec2(1e-6)));
    float motion = clamp(speedPx * 0.03, 0.0, 1.0);
    return 1.0 + 2.0 * depthEdge + 1.0 * motion;
}

void NeighborhoodBoxMinMaxRGB(ivec2 pixel, out vec3 nMin, out vec3 nMax) {
    nMin = vec3(1e10);
    nMax = vec3(-1e10);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec3 c = texelFetch(currentColor, pixel + ivec2(x, y), 0).rgb;
            nMin   = min(nMin, c);
            nMax   = max(nMax, c);
        }
    }
}

// Directional / ray-box clip into an AABB (YCoCg or RGB).
vec3 ClipAABB(vec3 history, vec3 aabbMin, vec3 aabbMax) {
    vec3 center  = 0.5 * (aabbMax + aabbMin);
    vec3 extents = 0.5 * (aabbMax - aabbMin) + vec3(1e-5);
    vec3 offset  = history - center;
    vec3 ts      = abs(offset / extents);
    float maxT   = max(ts.x, max(ts.y, ts.z));
    if (maxT > 1.0)
        return center + offset / maxT;
    return history;
}

// Optimized Catmull-Rom (9 bilinear taps) — High.
vec3 SampleHistoryCatmullRom(vec2 uv) {
    vec2 texSize    = 1.0 / pc.invResolution;
    vec2 samplePos  = uv * texSize;
    vec2 texPos1    = floor(samplePos - 0.5) + 0.5;
    vec2 f          = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12      = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-5));

    vec2 texPos0  = (texPos1 - 1.0) * pc.invResolution;
    vec2 texPos3  = (texPos1 + 2.0) * pc.invResolution;
    vec2 texPos12 = (texPos1 + offset12) * pc.invResolution;

    vec3 result = vec3(0.0);
    result += textureLod(historyColor, vec2(texPos0.x,  texPos0.y),  0.0).rgb *
              w0.x * w0.y;
    result += textureLod(historyColor, vec2(texPos12.x, texPos0.y),  0.0).rgb *
              w12.x * w0.y;
    result += textureLod(historyColor, vec2(texPos3.x,  texPos0.y),  0.0).rgb *
              w3.x * w0.y;

    result += textureLod(historyColor, vec2(texPos0.x,  texPos12.y), 0.0).rgb *
              w0.x * w12.y;
    result += textureLod(historyColor, vec2(texPos12.x, texPos12.y), 0.0).rgb *
              w12.x * w12.y;
    result += textureLod(historyColor, vec2(texPos3.x,  texPos12.y), 0.0).rgb *
              w3.x * w12.y;

    result += textureLod(historyColor, vec2(texPos0.x,  texPos3.y),  0.0).rgb *
              w0.x * w3.y;
    result += textureLod(historyColor, vec2(texPos12.x, texPos3.y),  0.0).rgb *
              w12.x * w3.y;
    result += textureLod(historyColor, vec2(texPos3.x,  texPos3.y),  0.0).rgb *
              w3.x * w3.y;
    return result;
}

// Explicit 4×4 Catmull-Rom (16 nearest taps) — Ultra.
float CatmullRomWeight(float x) {
    x = abs(x);
    if (x < 1.0)
        return (1.5 * x - 2.5) * x * x + 1.0;
    if (x < 2.0)
        return ((-0.5 * x + 2.5) * x - 4.0) * x + 2.0;
    return 0.0;
}

vec3 SampleHistoryCatmullRomHQ(vec2 uv) {
    vec2 texSize   = 1.0 / pc.invResolution;
    vec2 samplePos = uv * texSize - 0.5;
    ivec2 base     = ivec2(floor(samplePos));
    vec2 f         = samplePos - vec2(base);

    vec3  result = vec3(0.0);
    float wSum   = 0.0;
    for (int y = -1; y <= 2; ++y) {
        float wy = CatmullRomWeight(float(y) - f.y);
        for (int x = -1; x <= 2; ++x) {
            float wx = CatmullRomWeight(float(x) - f.x);
            float w  = wx * wy;
            ivec2 p  = clamp(base + ivec2(x, y), ivec2(0),
                             ivec2(texSize) - 1);
            result += texelFetch(historyColor, p, 0).rgb * w;
            wSum   += w;
        }
    }
    return result / max(wSum, 1e-5);
}

void NeighborhoodCrossMinMaxRGB(ivec2 pixel, out vec3 nMin, out vec3 nMax) {
    const ivec2 o[5] =
        ivec2[](ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1),
                ivec2(0, 1));
    nMin = vec3(1e10);
    nMax = vec3(-1e10);
    for (int i = 0; i < 5; ++i) {
        vec3 c = texelFetch(currentColor, pixel + o[i], 0).rgb;
        nMin   = min(nMin, c);
        nMax   = max(nMax, c);
    }
}

void NeighborhoodVarianceBox(ivec2 pixel, bool ycocg, bool gaussian,
                             out vec3 mu, out vec3 sigma) {
    vec3  m1   = vec3(0.0);
    vec3  m2   = vec3(0.0);
    float wSum = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            float w = 1.0;
            if (gaussian)
                w = float(2 - abs(x)) * float(2 - abs(y));
            vec3 c = texelFetch(currentColor, pixel + ivec2(x, y), 0).rgb;
            if (ycocg)
                c = RGBToYCoCg(c);
            m1   += c * w;
            m2   += c * c * w;
            wSum += w;
        }
    }
    float inv = 1.0 / max(wSum, 1e-5);
    mu        = m1 * inv;
    sigma     = sqrt(max(m2 * inv - mu * mu, vec3(0.0)));
}

vec3 SoftCurrent(ivec2 pixel) {
    vec3 c = texelFetch(currentColor, pixel, 0).rgb;
    c += texelFetch(currentColor, pixel + ivec2(-1, 0), 0).rgb;
    c += texelFetch(currentColor, pixel + ivec2(1, 0), 0).rgb;
    c += texelFetch(currentColor, pixel + ivec2(0, -1), 0).rgb;
    c += texelFetch(currentColor, pixel + ivec2(0, 1), 0).rgb;
    return c * 0.2;
}

vec3 ApplySharpen(vec3 result, ivec2 pixel, float strength, bool adaptive) {
    if (strength <= 1e-5)
        return result;

    vec3 soft    = SoftCurrent(pixel);
    vec3 current = texelFetch(currentColor, pixel, 0).rgb;
    vec3 detail  = current - soft;

    float amount = strength;
    if (adaptive) {
        float softL = Luma(soft);
        float resL  = Luma(result);
        float contrast =
            abs(resL - softL) / max(max(resL, softL), 1e-3);
        amount *= 1.0 - clamp(contrast, 0.0, 1.0);
    }

    return max(result + detail * amount, vec3(0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(outputColor);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    int q = int(pc.quality + 0.5);

    vec2  uv        = (vec2(pixel) + 0.5) * pc.invResolution;
    vec3  current   = textureLod(currentColor, uv, 0.0).rgb;
    float currDepth = texelFetch(currentDepth, pixel, 0).r;

    imageStore(outputDepth, pixel, vec4(currDepth, 0.0, 0.0, 0.0));

    if (pc.historyValid < 0.5) {
        imageStore(outputColor, pixel, vec4(current, 1.0));
        return;
    }

    // Dilated velocity (closest surface) for stable silhouette reprojection.
    float closestDepth;
    vec2  velocity  = DilateVelocity(pixel, closestDepth);
    vec2  historyUV = uv - velocity;

    bool offscreen = any(lessThan(historyUV, vec2(0.0))) ||
                     any(greaterThan(historyUV, vec2(1.0)));
    vec2 clampedUV = clamp(historyUV, vec2(0.0), vec2(1.0));

    vec3 history;
    if (q >= Q_ULTRA)
        history = SampleHistoryCatmullRomHQ(clampedUV);
    else if (q >= Q_HIGH)
        history = SampleHistoryCatmullRom(clampedUV);
    else
        history = textureLod(historyColor, clampedUV, 0.0).rgb;

    float weight    = pc.currentWeight;
    float histTrust = 1.0; // 1 = full history allowed
    float speedPx =
        length(velocity / max(pc.invResolution, vec2(1e-6)));

    // Pre-clip luma disagreement — dilated velocity often samples the moving
    // surface into newly uncovered background (faint High/Ultra trails).
    float lumaGhost =
        abs(Luma(current) - Luma(history)) /
        max(max(Luma(current), Luma(history)), 1e-3);

    if (offscreen) {
        weight    = 1.0;
        histTrust = 0.0;
    } else if (q == Q_LOW) {
        float dump = clamp(speedPx * 0.12, 0.0, 1.0);
        weight     = mix(pc.currentWeight, 1.0, dump);
        histTrust  = 1.0 - dump;
    } else {
        // Depth from jittered rasters differs frame-to-frame on silhouettes
        // even when still. Only trust depth reject under real motion.
        float histDepth = textureLod(historyDepth, clampedUV, 0.0).r;
        float depthDiff = abs(currDepth - histDepth);
        // Relative term: absolute device-Z alone is noisy with Reverse-Z.
        float depthRef  = max(max(currDepth, histDepth), 1e-3);
        float depthRel  = depthDiff / depthRef;
        float absUntrust =
            smoothstep(pc.depthReject * 0.75, pc.depthReject * 2.0, depthDiff);
        float relUntrust = smoothstep(0.04, 0.15, depthRel);
        float depthUntrust = min(absUntrust, relUntrust);
        float motionGate   = smoothstep(0.35, 1.75, speedPx);
        float depthTrust   = 1.0 - depthUntrust * motionGate;
        histTrust          = depthTrust;
        weight = mix(1.0, pc.currentWeight, depthTrust);

        // Soft floor keeps jitter AA; open toward full dump when history is
        // clearly a different surface (Medium hard-clamp hides this; variance
        // / ClipAABB on High+ leave a low-alpha trail otherwise).
        float rejectCap = 0.55;
        if (q >= Q_HIGH) {
            float ghostLikely =
                smoothstep(0.06, 0.28, lumaGhost) *
                smoothstep(0.2, 1.25, speedPx);
            rejectCap = mix(0.55, 0.98, ghostLikely);
            weight    = mix(weight, 1.0, ghostLikely * 0.85);
            histTrust *= (1.0 - ghostLikely * 0.85);
        }

        weight = min(weight, mix(pc.currentWeight, rejectCap, 1.0 - depthTrust));
    }

    if (weight < 0.999) {
        float boost = GammaBoost(pixel, velocity);
        // Motion-wide AABB lets dilated-velocity ghosts survive variance clip.
        if (q >= Q_HIGH)
            boost = mix(boost, 1.0 + 1.25 * (boost - 1.0), 0.65);

        if (q == Q_LOW) {
            vec3 nMin, nMax;
            NeighborhoodCrossMinMaxRGB(pixel, nMin, nMax);
            vec3 mid = 0.5 * (nMin + nMax);
            vec3 ext = 0.5 * (nMax - nMin) * boost;
            history  = clamp(history, mid - ext, mid + ext);
        } else if (q == Q_MEDIUM) {
            // 3×3 min/max RGB (more stable than variance on thin edges).
            vec3 nMin, nMax;
            NeighborhoodBoxMinMaxRGB(pixel, nMin, nMax);
            vec3 mid = 0.5 * (nMin + nMax);
            vec3 ext = 0.5 * (nMax - nMin) * max(boost, pc.varianceGammaY);
            history  = clamp(history, mid - ext, mid + ext);
        } else if (q == Q_HIGH) {
            vec3 mu, sigma;
            NeighborhoodVarianceBox(pixel, true, false, mu, sigma);
            // Floor sigma so flat neighborhoods still leave room for
            // sub-pixel history (jitter AA samples).
            sigma = max(sigma, vec3(0.002, 0.001, 0.001));
            vec3 gamma = vec3(pc.varianceGammaY, pc.varianceGammaC,
                              pc.varianceGammaC) *
                         boost;
            history =
                YCoCgToRGB(clamp(RGBToYCoCg(history), mu - gamma * sigma,
                                 mu + gamma * sigma));
        } else {
            vec3 mu, sigma;
            NeighborhoodVarianceBox(pixel, true, true, mu, sigma);
            sigma = max(sigma, vec3(0.002, 0.001, 0.001));
            vec3 gamma = vec3(pc.varianceGammaY, pc.varianceGammaC,
                              pc.varianceGammaC) *
                         boost;
            // ClipAABB keeps chroma trails; hard-clamp Y then clip chroma.
            vec3 hYCoCg = RGBToYCoCg(history);
            vec3 lo     = mu - gamma * sigma;
            vec3 hi     = mu + gamma * sigma;
            hYCoCg.x    = clamp(hYCoCg.x, lo.x, hi.x);
            hYCoCg      = ClipAABB(hYCoCg, lo, hi);
            history     = YCoCgToRGB(hYCoCg);
        }
    }

    // Residual ghost after variance soft-box (High+ only).
    if (q >= Q_HIGH && weight < 0.999) {
        float postGhost =
            abs(Luma(current) - Luma(history)) /
            max(max(Luma(current), Luma(history)), 1e-3);
        float kill = smoothstep(0.04, 0.20, postGhost) *
                     mix(0.2, 1.0, smoothstep(0.15, 1.0, speedPx));
        weight    = mix(weight, 1.0, kill * 0.9);
        histTrust *= (1.0 - kill * 0.9);
    }

    vec3 result = mix(history, current, weight);

    // Sharpen High+ only, and only where history stuck (avoid re-jitter).
    if (q >= Q_HIGH)
        result = ApplySharpen(result, pixel, pc.sharpen * histTrust, true);

    imageStore(outputColor, pixel, vec4(result, 1.0));
}
