#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "Include/freya_limits.inc"

layout(binding = 0) uniform sampler2D inDepth;
layout(binding = 1) uniform sampler2D inNormal;

layout(binding = 2) uniform LightBuffer {
    vec4 lightPositions[FREYA_MAX_LIGHTS];
    vec4 lightColorsAndRadius[FREYA_MAX_LIGHTS];
    vec4 lightDirectionsAndCutoff[FREYA_MAX_LIGHTS];
    vec4 lightOuterCutoffAndIntensity[FREYA_MAX_LIGHTS];
    vec4 lightAreaTangents[FREYA_MAX_LIGHTS];
    vec4 viewPosition;
    vec4 cameraForward;
    uint lightCount;
    float iblIntensity;
    float exposure;
} lights;

layout(binding = 3) uniform ShadowBuffer {
    mat4 cascadeViewProj[4];
    vec4 cascadeSplits;
    vec4 params;
    mat4 spotViewProj[4];
    vec4 spotLightIndex;
    vec4 pointLightPosFar[2];
    vec4 pointLightIndex;
    vec4 reverseZ;
    vec4 pcss;
    vec4 cascadeTexelSize;
} shadows;

layout(binding = 4) uniform sampler2DArrayShadow cascadeShadowMap;
// Bound so shadows.inc compiles; unused by SampleCascadeShadow.
layout(binding = 5) uniform sampler2DArrayShadow spotShadowMap;
layout(binding = 6) uniform samplerCubeArrayShadow pointShadowMap;

layout(binding = 7, r8) writeonly uniform image2D outMask;

layout(push_constant) uniform PC {
    mat4  invViewProjection;
    uvec2 extent;
    uint  reverseZFlag;
    uint  _pad;
} pc;

#define PBR_WITH_SHADOWS
#include "Include/shadows.inc"

vec3 ReconstructWorldPos(vec2 uv, float depth)
{
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = pc.invViewProjection * clip;
    return world.xyz / world.w;
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.extent.x || gid.y >= pc.extent.y)
        return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(pc.extent);
    float depth = textureLod(inDepth, uv, 0.0).r;
    bool reverseZ = pc.reverseZFlag != 0u;
    bool sky = reverseZ ? (depth <= 1e-6) : (depth >= 0.999999);
    if (sky || int(shadows.params.z) < 1)
    {
        imageStore(outMask, ivec2(gid), vec4(1.0));
        return;
    }

    vec3 worldPos = ReconstructWorldPos(uv, depth);
    vec3 N = normalize(textureLod(inNormal, uv, 0.0).rgb * 2.0 - 1.0);

    vec3 L = vec3(0.0, 1.0, 0.0);
    bool found = false;
    for (int i = 0; i < int(lights.lightCount); ++i)
    {
        float lightType = lights.lightPositions[i].w;
        if (lightType < 0.5 || lightType >= 1.5)
            continue;
        if (lights.lightOuterCutoffAndIntensity[i].w < 0.5)
            continue;
        L = normalize(-lights.lightDirectionsAndCutoff[i].xyz);
        found = true;
        break;
    }

    float visibility = found ? SampleCascadeShadow(worldPos, N, L) : 1.0;
    imageStore(outMask, ivec2(gid), vec4(visibility, 0.0, 0.0, 0.0));
}
